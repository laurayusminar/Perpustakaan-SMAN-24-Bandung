<%- include('partials/shell-start', { title }) %>
<section class="page-heading compact-heading">
  <div><div class="eyebrow"><span class="eyebrow-line"></span>PENGELOLAAN DATA</div><h1><%= title %><em>.</em></h1><p>Kelola informasi <%= config.singular %> perpustakaan.</p></div>
  <div class="heading-actions"><% if (config.table === 'anggota') { %><a class="button button-outline" href="/admin/data/anggota/bulk-class">Perbarui kelas massal</a><% } %><% if (['anggota', 'buku'].includes(config.table)) { %><button class="button button-outline" type="button" data-open-dialog="import-modal-<%= config.table %>">Import Data</button><% } %><a class="button button-dark" href="/admin/data/<%= config.table %>/new"><span class="button-plus">+</span> Tambah <%= config.singular %></a></div>
</section>
<% if (notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
<% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
<% if (importError) { %><div class="alert alert-error" role="alert"><%= importError %></div><% } %>
<% if (reviewNotice) { %><div class="alert alert-success" role="status"><%= reviewNotice %></div><% } %>
<% if (importResult) { %><div class="alert alert-success import-summary" role="status"><strong><%= importResult.imported %> data berhasil diimpor.</strong> <% if (importReview && importReview.items.length) { %> Ada <%= importReview.items.length %> data yang membutuhkan tindakan Anda. <button class="button button-outline review-open-button" type="button" data-open-dialog="import-review-dialog">Review Data <span aria-hidden="true">&#8599;</span></button><% } else { %><%= importResult.skipped %> baris dilewati.<% } %><% if (importResult.updated) { %> <%= importResult.updated %> data duplikat diperbarui.<% } %></div><% } %>
<section class="data-panel">
  <div class="panel-toolbar"><div class="panel-count"><strong><%= rows.length %></strong> <%= search || Object.keys(activeFilters).some((key) => config.filters?.some((filter) => filter.name === key) && activeFilters[key]) ? 'hasil filter' : 'data ditampilkan' %></div>
    <div class="table-tools"><form class="filter-form data-filter-form" action="/admin/data/<%= config.table %>" method="get"><label class="sr-only" for="search">Cari <%= config.singular %></label><input id="search" type="search" name="q" value="<%= search %>" placeholder="Cari <%= config.singular %>...">
      <% (config.filters || []).forEach((filter) => { %><label class="sr-only" for="filter-<%= filter.name %>"><%= filter.label %></label><select id="filter-<%= filter.name %>" name="<%= filter.name %>"><option value="">Semua <%= filter.label.toLowerCase() %></option><% (filters[filter.name] || []).forEach((option) => { %><option value="<%= option.value %>" <%= String(activeFilters[filter.name] || '') === String(option.value) ? 'selected' : '' %>><%= option.label %></option><% }) %></select><% }) %>
      <button class="button button-dark filter-submit" type="submit">Terapkan</button></form>
      <form class="export-form" action="/admin/data/<%= config.table %>/export" method="get"><input type="hidden" name="q" value="<%= search %>"><% (config.filters || []).forEach((filter) => { %><input type="hidden" name="<%= filter.name %>" value="<%= activeFilters[filter.name] || '' %>"><% }) %><button class="button button-outline export-button" type="submit"><span aria-hidden="true">&#8595;</span> Export Excel</button></form></div>
  </div>
  <% if (rows.length) { %><div class="table-wrap"><table><thead><tr><% config.columns.forEach((column) => { %><th><%= column.label.toUpperCase() %></th><% }) %><th class="actions-heading">AKSI</th></tr></thead><tbody>
  <% rows.forEach((row) => { %><tr><% config.columns.forEach((column) => { %><td><% if (column.name === 'jumlah_buku') { %><span class="stock-value <%= row[column.name] === 0 ? 'stock-empty' : '' %>"><%= row[column.name] %></span><% } else if (column.name === 'status' && config.table === 'anggota') { %><span class="member-status member-status-<%= row.status.toLowerCase() %>"><%= row.status %></span><% } else { %><%= row[column.name] || (column.name === 'alamat' || column.name === 'keterangan' ? '-' : '') %><% } %></td><% }) %><td class="row-actions"><a class="icon-action" href="/admin/data/<%= config.table %>/<%= encodeURIComponent(row[config.key]) %>/edit" title="Edit data" aria-label="Edit data"><span aria-hidden="true">&#9998;</span></a><form action="/admin/data/<%= config.table %>/<%= encodeURIComponent(row[config.key]) %>/delete" method="post" data-confirm="Hapus data ini? Tindakan ini tidak dapat dibatalkan."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-action action-delete" type="submit" title="Hapus data" aria-label="Hapus data"><span aria-hidden="true">&#215;</span></button></form></td></tr><% }) %>
  </tbody></table></div><% } else { %><div class="empty-state"><span class="empty-symbol">00</span><div><strong><%= search ? 'Data tidak ditemukan' : 'Belum ada data' %></strong><p><%= search ? 'Coba kata kunci yang berbeda.' : 'Tambahkan data pertama untuk mulai mengelola.' %></p></div></div><% } %>
</section>
<% if (['anggota', 'buku'].includes(config.table)) { %>
<dialog class="import-dialog" id="import-modal-<%= config.table %>" aria-labelledby="import-title-<%= config.table %>">
  <form class="import-modal-form" action="/admin/data/<%= config.table %>/import" method="post" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="import-modal-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>IMPOR DATA</div><h2 id="import-title-<%= config.table %>">Import <%= config.singular %></h2></div><button class="dialog-close" type="button" data-close-dialog aria-label="Tutup">&#215;</button></div>
    <p class="import-guidance">Anda dapat mengunggah file Excel/CSV langsung. Sistem akan otomatis mencocokkan kolom yang diperlukan.</p>
    <a class="template-download" href="/admin/data/<%= config.table %>/template"><span aria-hidden="true">&#8595;</span> Download Template CSV</a>
    <label class="field import-file-field"><span>Pilih file `.xlsx` atau `.csv`</span><input type="file" name="file" accept=".xlsx,.csv,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required><small class="field-hint">Maksimal 5 MB dan 5.000 baris data.</small></label>
    <label class="field"><span>Jika ditemukan data duplikat</span><select name="duplicate_strategy"><option value="skip" selected>Lewati data yang sudah ada</option><option value="update">Perbarui data yang sudah ada</option></select></label>
    <div class="import-modal-actions"><button class="button button-outline" type="button" data-close-dialog>Batal</button><button class="button button-dark" type="submit">Proses Import <span aria-hidden="true">&#8594;</span></button></div>
  </form>
</dialog>
<% } %>
<% if (importReview && importReview.items.length) { %>
<dialog class="import-dialog import-review-dialog" id="import-review-dialog" aria-labelledby="import-review-title">
  <div class="import-modal-form">
    <div class="import-modal-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>TINJAUAN IMPOR</div><h2 id="import-review-title">Data perlu diperbaiki</h2></div><button class="dialog-close" type="button" data-close-dialog aria-label="Tutup">&#215;</button></div>
    <p class="import-guidance">Perbaiki nilai yang ditandai lalu simpan ulang, atau abaikan baris tersebut. Baris Excel asli tetap tercatat untuk pengecekan.</p>
    <div class="review-table-wrap"><table class="review-table"><thead><tr><th>BARIS EXCEL</th><th>DATA INPUT</th><th>PENYEBAB ERROR</th><th>AKSI</th></tr></thead><tbody>
      <% importReview.items.forEach((item) => { %><tr data-review-row="<%= item.id %>"><td class="review-row-number"><%= item.rowNumber %></td><td><form id="review-form-<%= item.id %>" class="review-row-form" action="/admin/data/<%= config.table %>/import-review/<%= importReview.id %>/<%= item.id %>/save" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="review-input-grid"><% item.mappedFields.forEach((field) => { %><label class="field"><span><%= field === 'nis' ? 'NIS' : field === 'nama' ? 'Nama siswa' : field === 'kelas' ? 'Kelas' : field === 'no_telp' ? 'No. telepon' : field === 'alamat' ? 'Alamat' : field === 'kode_buku' ? 'Kode buku' : field === 'judul_buku' ? 'Judul buku' : field === 'pengarang' ? 'Pengarang' : field === 'penerbit' ? 'Penerbit' : field === 'tahun_terbit' ? 'Tahun terbit' : field === 'jumlah_buku' ? 'Jumlah stok' : field === 'isbn' ? 'ISBN' : 'Kategori' %></span><input name="<%= field %>" value="<%= item.data[field] || '' %>" maxlength="<%= field === 'alamat' ? 500 : field === 'nama' || field === 'judul_buku' ? 240 : 160 %>" <%= ['nis', 'nama', 'kode_buku', 'judul_buku'].includes(field) ? 'required' : '' %>></label><% }) %></div></form></td><td><ul class="review-reasons"><% item.reasons.forEach((reason) => { %><li><%= reason %></li><% }) %></ul></td><td class="review-actions"><button class="button button-dark review-save-button" type="submit" form="review-form-<%= item.id %>" title="Edit dan simpan ulang" aria-label="Edit dan simpan ulang"><span aria-hidden="true">&#9998;</span> Simpan</button><form action="/admin/data/<%= config.table %>/import-review/<%= importReview.id %>/<%= item.id %>/ignore" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-outline review-ignore-button" type="submit" title="Abaikan baris" aria-label="Abaikan baris"><span aria-hidden="true">&#128465;</span> Abaikan</button></form></td></tr><% }) %>
    </tbody></table></div>
    <div class="review-footer"><span><%= importReview.items.length %> baris menunggu tindakan</span><button class="button button-outline" type="button" data-close-dialog>Tutup</button></div>
  </div>
</dialog>
<% } %>
<%- include('partials/shell-end') %>
